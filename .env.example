# Interval cache sumber eksternal (detik)
CCTV_CACHE_TTL=300
# Host tambahan yang boleh di-proxy (dipisah koma). Host dari config/sources.json & data/*.json otomatis diizinkan.
CCTV_PROXY_ALLOW=
# Set "1" untuk mengizinkan POST/DELETE kamera via API tanpa token (default: butuh token)
CCTV_ADMIN_TOKEN=ganti-dengan-token-rahasia
